# 系统 / 编辑器
.DS_Store
Thumbs.db
desktop.ini
~$*.docx       # Word 临时锁文件
~$*.xlsx       # Excel 临时锁文件
*.swp
*.swo

# 过程产物
*.bak
*.tmp

# 构建 / 缓存
node_modules/
__pycache__/
*.pyc
.gradle/
build/
dist/
# 例外:Maid RPG 文档站产物是发布物(纯静态站),需随仓库版本化
!projects/maid-rpg/site/dist/

# 引擎 / 编辑器临时
.vs/
.vscode/
.idea/
*.tmpproj/

# Godot / Unity / UE 特定
.import/
.imported/
*.translation
*.gd.meta
*.cs.meta

# mavis memory 工具同步标记(本地状态，不提交)
.last-sync

# 本机一次性脚本(硬编码本机绝对路径,不进仓库)
_sync_memory.py

# Godot 临时文件 / 缓存(封印勇者项目)
封印勇者/GodotProject/.godot/
封印勇者/GodotProject/.import/
封印勇者/**/*.uid

# Godot 临时文件 / 缓存(maze-tbs 项目,2026-08-25)
maze-tbs/GodotProject/.godot/
maze-tbs/GodotProject/.import/
maze-tbs/**/*.uid

# Godot 临时文件 / 缓存(maid-rpg 项目,2026-10-26)
projects/maid-rpg/GodotProject/.godot/
projects/maid-rpg/GodotProject/.import/
projects/maid-rpg/**/*.uid
